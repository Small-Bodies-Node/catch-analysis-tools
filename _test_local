#!/usr/bin/env bash
#
# Run locally inside the project Docker image.

set -euo pipefail
IFS=$'\n\t'

if [[ ! -f ".env" ]]; then
  echo "Missing .env file. Copy .env-template and configure required values." >&2
  exit 1
fi

# shellcheck disable=SC1091
source .env

required_vars=(DOCKER_IMAGE_NAME DOCKER_IMAGE_TAG TF_VAR_CAT_ARCHITECTURE)
for var in "${required_vars[@]}"; do
  if [[ -z "${!var:-}" ]]; then
    echo "${var} must be set in .env" >&2
    exit 1
  fi
done

echo "Open http://localhost:8000/ui/ in your browser once the server is ready."
echo "Running the built image through the canonical Docker Compose configuration."

set -x
docker compose up --no-build app
set +x

echo "Container test completed."
